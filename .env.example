# LaunchLog frontend environment.
# Real values live in .env (gitignored). For Railway, mirror these keys in the service Variables tab.
# Set this to production on providers that do not expose Railway/Vercel's
# native environment markers. Leave it empty for local and CI artifact builds.
NUXT_DEPLOY_ENVIRONMENT=

# API.
NUXT_PUBLIC_API_URL=https://api.launchlog.ai
NUXT_PUBLIC_DOMAIN=launchlog.ai

# Firebase Auth (project launchlog-prod). 6 fields — no measurementId per D-032 (Plausible, not GA4).
NUXT_PUBLIC_FIREBASE_API_KEY=<from-firebase-console>
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NUXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Optional self-hosted Plausible analytics. All three values are required and
# the browser sends only approved events after an explicit analytics choice.
NUXT_PUBLIC_PLAUSIBLE_ENABLED=false
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=launchlog.ai
NUXT_PUBLIC_PLAUSIBLE_ENDPOINT=https://plausible.launchlog.ai/api/event

# Public brand plus formal contracting-provider identity. These public facts
# are mirrored by the API; keep the full registered identity on legal surfaces.
NUXT_PUBLIC_LEGAL_NAME="AB SOLUTIONS S.R.L."
NUXT_PUBLIC_LEGAL_ADDRESS="Str. Grigore Alexandrescu nr. 174, camera 1, sc. A, et. 3, ap. 12, 300369 Timișoara, jud. Timiș, România"
NUXT_PUBLIC_LEGAL_REGISTRATION_ID=J35/1784/2023
NUXT_PUBLIC_LEGAL_TAX_ID=48116710
NUXT_PUBLIC_LEGAL_SHARE_CAPITAL=<registered share capital>
NUXT_PUBLIC_LEGAL_PHONE=<public business telephone>
NUXT_PUBLIC_LEGAL_EMAIL=<legal mailbox>
NUXT_PUBLIC_SUPPORT_EMAIL=<support mailbox>
NUXT_PUBLIC_DMCA_EMAIL=<copyright mailbox>

# Optional external status page. Empty falls back to the support channel on /status.
NUXT_PUBLIC_STATUS_PAGE_URL=

# Required in production: accountant-approved tax wording in each public locale.
# The two values must carry the same legal meaning; never machine-translate or guess them.
NUXT_PUBLIC_TAX_NOTICE_EN=
NUXT_PUBLIC_TAX_NOTICE_RO=
