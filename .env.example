# LaunchLog frontend environment.
# Real values live in .env (gitignored). For Railway, mirror these keys in the service Variables tab.

# API.
NUXT_PUBLIC_API_URL=https://api.launchlog.ai
NUXT_PUBLIC_DOMAIN=launchlog.ai

# Firebase Auth (project launchlog-prod). 6 fields — no measurementId per D-032 (Plausible, not GA4).
NUXT_PUBLIC_FIREBASE_API_KEY=<from-firebase-console>
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NUXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Optional self-hosted Plausible analytics. All three values are required.
NUXT_PUBLIC_PLAUSIBLE_ENABLED=false
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=launchlog.ai
NUXT_PUBLIC_PLAUSIBLE_ENDPOINT=https://plausible.launchlog.ai/api/event

# Optional Meta advertising measurement. The public dataset ID is safe in the
# browser; the Conversions API token must exist only in the Railway Variables tab.
NUXT_PUBLIC_META_PIXEL_ENABLED=false
NUXT_PUBLIC_META_PIXEL_ID=<meta-dataset-id>
NUXT_META_CONVERSIONS_ENABLED=false
NUXT_META_PIXEL_ID=<same-meta-dataset-id>
NUXT_META_CONVERSIONS_ACCESS_TOKEN=<railway-secret-only>
NUXT_META_GRAPH_API_VERSION=<version-from-meta-generated-setup>
# Set only while validating events in Events Manager, then clear it.
NUXT_META_TEST_EVENT_CODE=

# Public operator and support identity. Consumed by the footer and by /contact,
# /terms, /privacy, /dmca, /help, /status and /cookies. The operator defaults
# to AB Solutions in code; the mailbox blocks stay hidden when unset.
NUXT_PUBLIC_LEGAL_NAME=AB Solutions
NUXT_PUBLIC_LEGAL_EMAIL=<legal mailbox>
NUXT_PUBLIC_SUPPORT_EMAIL=<support mailbox>
NUXT_PUBLIC_DMCA_EMAIL=<copyright mailbox>

# Optional external status page. Empty falls back to the support channel on /status.
NUXT_PUBLIC_STATUS_PAGE_URL=

# One accountant-approved sentence on tax treatment, rendered identically on
# Pricing, Help and Terms. Empty renders nothing: never guess a tax treatment.
NUXT_PUBLIC_TAX_NOTICE=
